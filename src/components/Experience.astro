---
import { Image } from "astro:assets";
import Section from "@/components/Section.astro";
import { experiences } from "@/data/experiences";
---

<Section id="work" aria-label="Work experience">
  <ol class="relative ml-6 list-none border-l-4 border-line sm:ml-8">
    {experiences.map((experience) => (
      <li class="relative mb-12 pl-10 last:mb-0 sm:pl-14" data-reveal>
        <a
          href={experience.website}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute top-0 -left-[30px] flex size-14 items-center justify-center rounded-full p-2 shadow-lg sm:-left-[34px] sm:size-16"
          style={`background: ${experience.logoBg}`}
          aria-label={`${experience.company} website`}
        >
          <Image src={experience.logo} alt="" width={64} height={64} class="size-full rounded-full object-contain" />
        </a>

        <article class="rounded-xl bg-card p-6 shadow-md">
          <h3 class="text-secondary text-base font-semibold">
            <a href={experience.website} target="_blank" rel="noopener noreferrer" class="hover:text-fg">
              {experience.company}
            </a>
          </h3>

          <ol class="mt-3 list-none space-y-6">
            {experience.roles.map((role, index) => (
              <li class:list={[index > 0 && "border-t border-fg/10 pt-6"]}>
                <p class="text-lg font-bold text-fg sm:text-xl">{role.title}</p>
                <p class="text-secondary mt-1 text-sm font-medium">{role.date}</p>
                <ul class="mt-4 ml-5 list-disc space-y-2">
                  {role.points.map((point) => (
                    <li class="text-white-100 pl-1 text-sm tracking-wider">{point}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </article>
      </li>
    ))}
  </ol>
</Section>
