---
import { Image } from "astro:assets";
import Section from "@/components/Section.astro";
import { experiences } from "@/data/experiences";
---

<Section id="work" aria-label="Work experience">
  <ol class="relative ml-6 list-none border-l-4 border-[#232631] sm:ml-8">
    {experiences.map((experience) => (
      <li class="relative mb-12 pl-10 last:mb-0 sm:pl-14" data-reveal>
        <a
          href={experience.website}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute top-0 -left-[30px] flex size-14 items-center justify-center rounded-full p-2 shadow-lg sm:-left-[34px] sm:size-16"
          style={`background: ${experience.logoBg}`}
          aria-label={`${experience.company} website`}
        >
          <Image src={experience.logo} alt="" width={64} height={64} class="size-full rounded-full object-contain" />
        </a>

        <p class="text-secondary mb-2 text-sm font-medium">{experience.date}</p>
        <article class="rounded-xl bg-[#1d1836] p-6 shadow-md">
          <h3 class="text-xl font-bold text-white">{experience.title}</h3>
          <p class="text-secondary mt-1 text-base font-semibold">
            <a href={experience.website} target="_blank" rel="noopener noreferrer" class="hover:text-white">
              {experience.company}
            </a>
          </p>
          <ul class="mt-4 ml-5 list-disc space-y-2">
            {experience.points.map((point) => (
              <li class="text-white-100 pl-1 text-sm tracking-wider">{point}</li>
            ))}
          </ul>
        </article>
      </li>
    ))}
  </ol>
</Section>
