---
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/Section.astro";
import { projects } from "@/data/projects";

const featured = projects.filter((project) => project.featured);
const earlier = projects.filter((project) => !project.featured);
---

<Section id="projects">
  <div data-reveal>
    <p class="section-sub">My Work</p>
    <h2 class="section-head">Projects.</h2>
  </div>

  <p class="text-secondary mt-3 max-w-3xl text-[17px] leading-[30px]" data-reveal data-reveal-delay="100">
    This section contains projects that showcase my skills and experience through real-world examples of my work. Each
    project is briefly described with links to code repositories and live demos in it. The section spotlights my ability
    to solve complex business problems, work with different technologies, and manage projects effectively.
  </p>

  <ul class="mt-16 grid list-none gap-7 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((project, index) => (
      <li data-reveal data-reveal-delay={(index % 3) * 150}>
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>

  {earlier.length > 0 && (
    <div class="mt-16" data-reveal>
      <h3 class="text-2xl font-bold text-fg">Earlier work</h3>
      <ul class="mt-6 grid list-none gap-4 sm:grid-cols-2">
        {earlier.map((project) => (
          <li class="bg-tertiary/60 rounded-xl p-4">
            <p class="font-semibold text-fg">
              {project.sourceUrl ? (
                <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold">
                  {project.name} ↗
                </a>
              ) : (
                project.name
              )}
            </p>
            <p class="text-secondary mt-1 text-sm">{project.description}</p>
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>
