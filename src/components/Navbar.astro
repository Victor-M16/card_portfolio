---
import { Image } from "astro:assets";
import avatar from "@/assets/victorsmile.jpg";
import { navLinks, site } from "@/data/site";

const isBlog = Astro.url.pathname.startsWith("/blog");
---

<header class="bg-primary/90 fixed top-0 z-20 w-full backdrop-blur">
  <nav aria-label="Main" class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 sm:px-16">
    <a href="/" class="flex items-center gap-2">
      <Image src={avatar} alt="" width={36} height={36} class="size-9 rounded-full object-cover" loading="eager" />
      <span class="text-[18px] font-bold text-white">
        {site.shortName}
        <span class="hidden sm:inline"> Mjimapemba</span>
      </span>
    </a>

    <ul class="hidden list-none gap-10 sm:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isBlog && link.href === "/blog" ? "page" : undefined}
            class="text-secondary text-[18px] font-medium transition-colors hover:text-white aria-[current=page]:text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="sm:hidden">
      <button
        id="menu-toggle"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        class="flex size-10 items-center justify-center rounded-lg text-white"
      >
        <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path data-icon="open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          <path data-icon="close" class="hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
      <ul
        id="mobile-menu"
        class="black-gradient absolute top-20 right-0 mx-4 my-2 hidden min-w-[160px] list-none flex-col gap-4 rounded-xl p-6"
      >
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="text-secondary text-[16px] font-medium hover:text-white">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.classList.toggle("hidden", !open);
      menu.classList.toggle("flex", open);
      toggle.querySelector('[data-icon="open"]')?.classList.toggle("hidden", open);
      toggle.querySelector('[data-icon="close"]')?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
