---
import Section from "@/components/Section.astro";
import { certifications, education, highlights } from "@/data/credentials";
---

<Section id="highlights">
  <div data-reveal>
    <p class="section-sub">Recognition</p>
    <h2 class="section-head">Highlights.</h2>
  </div>

  <ul class="mt-12 grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {highlights.map((item, index) => (
      <li class="bg-tertiary rounded-2xl p-6" data-reveal data-reveal-delay={(index % 3) * 120}>
        {item.year && <p class="text-gold text-sm font-semibold">{item.year}</p>}
        <h3 class="mt-1 text-lg font-bold text-fg">{item.title}</h3>
        <p class="text-secondary mt-2 text-sm">{item.detail}</p>
      </li>
    ))}
  </ul>

  <div class="mt-16 grid gap-12 lg:grid-cols-2">
    <div data-reveal>
      <h3 class="text-2xl font-bold text-fg">Education</h3>
      <ol class="mt-6 list-none space-y-6">
        {education.map((item) => (
          <li class="border-gold border-l-2 pl-4">
            <p class="text-secondary text-sm">{item.dates}</p>
            <p class="font-semibold text-fg">{item.school}</p>
            <p class="text-white-100 text-sm">{item.qualification}</p>
            <p class="text-secondary text-sm">{item.result}</p>
          </li>
        ))}
      </ol>
    </div>

    <div data-reveal data-reveal-delay="120">
      <h3 class="text-2xl font-bold text-fg">Certifications</h3>
      <ul class="mt-6 list-none space-y-4">
        {certifications.map((item) => (
          <li class="flex items-baseline justify-between gap-4 border-b border-fg/10 pb-3">
            <span>
              <span class="font-semibold text-fg">{item.name}</span>
              <span class="text-secondary block text-sm">{item.issuer}</span>
            </span>
            {item.date && <span class="text-secondary shrink-0 text-sm">{item.date}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
