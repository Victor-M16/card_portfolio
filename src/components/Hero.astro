---
import { getImage } from "astro:assets";
import poster from "@/assets/hero-poster.jpg";

const posterImage = await getImage({ src: poster, width: 1280, format: "webp" });
---

<section class="relative h-svh w-full overflow-hidden" aria-label="Introduction">
  <video
    class="absolute inset-0 size-full object-cover"
    src="/hero.mp4"
    poster={posterImage.src}
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    aria-hidden="true"
  ></video>
  <!-- Darkens the video so the text stays readable. -->
  <div class="from-[#050816]/70 via-[#050816]/50 to-primary absolute inset-0 bg-gradient-to-b"></div>

  <div class="relative mx-auto flex max-w-7xl flex-row items-start gap-5 px-6 pt-32 sm:px-16">
    <div class="mt-5 flex flex-col items-center" aria-hidden="true">
      <div class="bg-[#f7bd25] size-5 rounded-full"></div>
      <div class="gold-gradient h-40 w-1 sm:h-80"></div>
    </div>

    <div data-reveal>
      <p class="text-[#f7bd25] text-[12px] font-semibold tracking-[0.2em] uppercase xs:text-[14px] sm:text-[16px]">
        Real-time information &amp; control systems
      </p>
      <h1 class="mt-2 text-[40px] font-black text-white xs:text-[50px] sm:text-[55px] lg:text-[70px] lg:leading-[98px]">
        Hi, I'm <span class="text-[#f7bd25]">Victor</span>
      </h1>
      <p class="text-[#f3f3f3] mt-2 max-w-3xl text-[16px] font-medium xs:text-[20px] sm:text-[23px] lg:text-[27px] lg:leading-[40px]">
        I build AI that runs on the hardware Malawi actually has. Voice assistants on ordinary phone calls, ID checks on
        a bank's CPUs, face recognition on a Raspberry Pi.
      </p>
    </div>
  </div>

  <div class="absolute bottom-20 flex w-full justify-center">
    <a href="#about" aria-label="Scroll to About">
      <div class="border-[#aaa6c3] flex h-[64px] w-[35px] items-start justify-center rounded-3xl border-4 p-2">
        <div class="bg-[#aaa6c3] animate-scroll-cue mb-1 size-3 rounded-full"></div>
      </div>
    </a>
  </div>
</section>

<style>
  .animate-scroll-cue {
    animation: scroll-cue 1.5s ease-in-out infinite;
  }
</style>
