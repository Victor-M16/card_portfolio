---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { theStillFlame as book } from "@/data/books";
import { chapterMinutes, getChapters } from "@/lib/books";

export const getStaticPaths = (async () => {
  const chapters = await getChapters(book.id);
  return chapters.map((chapter, index) => ({
    params: { chapter: chapter.id },
    props: { chapter, index, total: chapters.length, prev: chapters[index - 1], next: chapters[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { chapter, index, total, prev, next } = Astro.props;
const { Content } = await render(chapter);
const base = `/fun/${book.id}`;
const title = chapter.data.title;
const description = `${title}, from ${book.title} (${book.series}), a science-fantasy novel by ${book.author}. Read it free online.`;
---

<BaseLayout title={`${title} | ${book.title}`} description={description} image={book.ogImage}>
  <link slot="head" rel="prev" href={prev ? `${base}/${prev.id}/` : `${base}/`} />
  {next && <link slot="head" rel="next" href={`${base}/${next.id}/`} />}

  <article class="mx-auto max-w-[68ch] px-6 pt-32 pb-16">
    <nav aria-label="Book" class="text-secondary flex items-center justify-between gap-4 text-sm">
      <a href={`${base}/`} class="hover:text-fg">
        ← {book.title}: Contents
      </a>
      <span>
        {index + 1} of {total}
      </span>
    </nav>

    <header class="mt-12 mb-10 text-center">
      <p class="text-secondary text-sm tracking-[0.2em] uppercase">{book.title}</p>
      <h1 class="mt-3 font-serif text-4xl font-bold text-fg sm:text-5xl">{title}</h1>
      <p class="text-secondary mt-3 text-sm">{chapterMinutes(chapter.body)} min read</p>
    </header>

    <div class="book-prose">
      <Content />
    </div>

    <nav aria-label="Chapters" class="mt-16 grid gap-4 border-t border-fg/10 pt-8 sm:grid-cols-2">
      {prev ? (
        <a href={`${base}/${prev.id}/`} class="bg-tertiary rounded-xl p-4 hover:text-gold">
          <span class="text-secondary block text-sm">← Previous</span>
          <span class="font-serif">{prev.data.title}</span>
        </a>
      ) : (
        <a href={`${base}/`} class="bg-tertiary rounded-xl p-4 hover:text-gold">
          <span class="text-secondary block text-sm">← Back to</span>
          <span class="font-serif">Contents</span>
        </a>
      )}
      {next ? (
        <a href={`${base}/${next.id}/`} class="bg-tertiary rounded-xl p-4 text-right hover:text-gold">
          <span class="text-secondary block text-sm">Next →</span>
          <span class="font-serif">{next.data.title}</span>
        </a>
      ) : (
        <a href={`${base}/`} class="bg-tertiary rounded-xl p-4 text-right hover:text-gold">
          <span class="text-secondary block text-sm">The end of Book One</span>
          <span class="font-serif">Back to contents</span>
        </a>
      )}
    </nav>

    <p class="mt-8 text-center">
      <a href={`${base}/`} class="text-gold text-sm font-medium hover:underline">
        Contents
      </a>
    </p>
    <p class="text-secondary mt-6 text-center text-sm">{book.copyright}</p>
  </article>
</BaseLayout>
