---
import About from "@/components/About.astro";
import Companies from "@/components/Companies.astro";
import Contact from "@/components/Contact.astro";
import Credentials from "@/components/Credentials.astro";
import Experience from "@/components/Experience.astro";
import Hero from "@/components/Hero.astro";
import LatestPosts from "@/components/LatestPosts.astro";
import Projects from "@/components/Projects.astro";
import Tech from "@/components/Tech.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BookPromo from "@/components/BookPromo.astro";
import Section from "@/components/Section.astro";
---

<BaseLayout>
  <Hero />
  <About />
  <Companies />
  <Experience />
  <Credentials />
  <Tech />
  <Projects />
  <LatestPosts />
  <Section id="fun" aria-labelledby="fun-heading">
    <div data-reveal>
      <p class="section-sub">For fun</p>
      <h2 id="fun-heading" class="section-head">
        I also write fiction.
      </h2>
    </div>
    <div class="mt-10" data-reveal data-reveal-delay="100">
      <BookPromo />
    </div>
  </Section>
  <Contact />
</BaseLayout>
