---
import type { GetStaticPaths } from "astro";
import { getImage, Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getPosts, readingTime, slugifyTag } from "@/lib/blog";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, cover, coverAlt, tags, draft } = post.data;
const { Content } = await render(post);

const ogImage = cover ? (await getImage({ src: cover, width: 1200, height: 630, format: "jpg" })).src : undefined;
---

<BaseLayout title={title} description={description} image={ogImage} type="article" publishedTime={pubDate}>
  <article class="mx-auto max-w-3xl px-6 pt-32 pb-16">
    <a href="/blog" class="text-secondary hover:text-white">
      ← All posts
    </a>

    <header class="mt-6">
      {draft && (
        <p class="bg-gold text-primary mb-4 w-fit rounded px-2 py-0.5 text-xs font-bold">DRAFT – not published</p>
      )}
      <h1 class="text-4xl font-black text-white sm:text-5xl">{title}</h1>
      <p class="text-secondary mt-4">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <>
            {" "}
            · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </>
        )}
        {" · "}
        {readingTime(post.body)}
      </p>
      {tags.length > 0 && (
        <ul class="mt-4 flex list-none flex-wrap gap-3 text-sm">
          {tags.map((tag) => (
            <li>
              <a href={`/blog/tags/${slugifyTag(tag)}/`} class="text-gradient-blue">
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {cover && (
      <Image
        src={cover}
        alt={coverAlt ?? ""}
        width={1440}
        widths={[720, 1440]}
        sizes="(min-width: 768px) 768px, 100vw"
        class="mt-8 w-full rounded-2xl"
        loading="eager"
      />
    )}

    <div class="prose prose-invert prose-lg prose-a:text-gold prose-headings:scroll-mt-28 prose-img:rounded-xl prose-pre:bg-black-200 prose-code:before:content-none prose-code:after:content-none mt-10 max-w-none">
      <Content />
    </div>

    {(newer || older) && (
      <nav aria-label="More posts" class="mt-16 grid gap-4 border-t border-white/10 pt-8 sm:grid-cols-2">
        {older ? (
          <a href={`/blog/${older.id}/`} class="bg-tertiary rounded-xl p-4 hover:text-gold">
            <span class="text-secondary block text-sm">← Older</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a href={`/blog/${newer.id}/`} class="bg-tertiary rounded-xl p-4 text-right hover:text-gold">
            <span class="text-secondary block text-sm">Newer →</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
