---
import Section from "@/components/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <Section class="pt-40 text-center">
    <p class="section-sub">404</p>
    <h1 class="section-head">Nothing here.</h1>
    <p class="text-secondary mt-4">That page doesn't exist, or it moved.</p>
    <a href="/" class="text-gold mt-8 inline-block font-medium hover:underline">
      ← Back home
    </a>
  </Section>
</BaseLayout>
