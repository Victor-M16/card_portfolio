# Copy to .env for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# API key from https://resend.com/api-keys (required for the contact form).
RESEND_API_KEY=

# Where contact form messages are delivered. Defaults to vcmjimapemba@gmail.com.
# CONTACT_TO_EMAIL=

# Sender address. Resend's shared onboarding@resend.dev sender can only deliver
# to the email on your Resend account; verify your own domain to use e.g.
# "Victor <hello@yourdomain.com>".
# CONTACT_FROM_EMAIL=

# Canonical site URL for sitemap/RSS/social previews, once you have a custom
# domain. Vercel's production domain is used automatically otherwise.
# SITE_URL=https://example.com
